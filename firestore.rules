rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == "salvisarthak2007@gmail.com")
      );
    }

    function isCollegeOwner(collegeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/institutions/$(collegeId)) &&
        get(/databases/$(database)/documents/institutions/$(collegeId)).data.ownerUid == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isUser(userId);
      allow update: if (isUser(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isUser(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isUser(adminId);
      allow update, delete: if isUser(adminId) || isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subscriptionId} {
      allow get: if isSignedIn() && (resource.data.adminUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.adminUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Institutions / Colleges
    match /institutions/{institutionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Messes / Dining Halls
    match /messes/{messId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isCollegeOwner(request.resource.data.collegeId) || isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        isCollegeOwner(resource.data.collegeId) || isAdmin()
      );
    }

    // Menus
    match /menus/{menuId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isCollegeOwner(request.resource.data.collegeId) || isAdmin()
      );
    }

    // Meal ratings
    match /mealRatings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isCollegeOwner(resource.data.collegeId);
    }

    // Feedback (Complaints & Suggestions)
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isCollegeOwner(resource.data.collegeId)
        )
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isCollegeOwner(resource.data.collegeId)
        )
      );
      allow delete: if isAdmin() || isCollegeOwner(resource.data.collegeId);
    }

    // Polls
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isCollegeOwner(request.resource.data.collegeId) || isAdmin()
      );
    }

    // Poll Responses (Votes)
    match /pollResponses/{responseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isCollegeOwner(request.resource.data.collegeId) || isAdmin()
      );
    }
  }
}
